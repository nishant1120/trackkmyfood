# NutriTrack environment variables. Copy to .env.local and fill in.
# Never commit .env.local — it's gitignored.

# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, used by `npm run seed` and not bundled into the app
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (required for AI text + vision)
# Get a key at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=

# USDA FoodData Central (required only for `npm run seed`)
# Get a key at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Sentry (optional). Leave empty to disable error reporting.
EXPO_PUBLIC_SENTRY_DSN=

# Dev-only. Pre-fills the __DEV__ password sign-in. Set this if you've
# created a password user in Supabase for testing. Production builds
# strip __DEV__ entirely so this never reaches end users.
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=
